<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV007 — Monthly partitioning of trades on Postgres
 WHAT:    Convert trades into a range-partitioned parent on trade_date and
          create partitions for the current rolling 12 months.
 HOW:     Postgres-only via raw SQL. The trainer guide for Day 1 documents
          the "rename, recreate as partitioned, copy data" pattern that
          students must run if production data already exists. In this clean
          starter we recreate trades directly since there's nothing to copy.
 WHY:     500-million-row trades table would kill EXPLAIN; monthly partitions
          give predictable prune-by-date plans.
 OBSERVE: \d+ trades shows "Partitioned table" + 12 child partitions.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Demonstration only: the partitioning conversion is destructive and is
         taught in the trainer guide Day-1 Sprint 0B. In this starter we
         create a single partition for the rolling-current-month so the
         seed data has somewhere to land. -->
    <changeSet id="004-partition-current-month" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <comment>Placeholder: students rebuild this in ADV007. Trainer copy
                 ships a no-op so dev/uat boot cleanly.</comment>
        <sql>SELECT 1;</sql>
        <rollback>
            <sql>SELECT 1;</sql>
        </rollback>
    </changeSet>

    <!-- Pattern 1: Idempotent table creation (most common) -->
    <changeSet id="011-mv-daily-recon-summary" author="trainer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="mv_daily_recon_summary"/>
            </not>
        </preConditions>
    
        <sql>
            CREATE MATERIALIZED VIEW mv_daily_recon_summary AS
            SELECT t.trade_date, cp.region, i.asset_class,
                   COUNT(*) AS total_trades
            FROM trades t
            JOIN counterparties cp ON cp.id = t.counterparty_id
            JOIN instruments    i  ON i.id  = t.instrument_id
            GROUP BY t.trade_date, cp.region, i.asset_class
            WITH NO DATA;
    
            CREATE UNIQUE INDEX uq_mv_daily_recon_summary
                ON mv_daily_recon_summary (trade_date, region, asset_class);
        </sql>
    
        <rollback>
            DROP MATERIALIZED VIEW IF EXISTS mv_daily_recon_summary;
        </rollback>
    </changeSet>
    
    <!-- Pattern 2: Composed precondition with column existence -->
    <changeSet id="012-add-rating-column" author="trainer">
        <preConditions onFail="CONTINUE">
            <and>
                <tableExists tableName="instruments"/>
                <not><columnExists tableName="instruments" columnName="rating"/></not>
            </and>
        </preConditions>
    
        <addColumn tableName="instruments">
            <column name="rating" type="VARCHAR(10)"/>
        </addColumn>
    
        <rollback>
            <dropColumn tableName="instruments" columnName="rating"/>
        </rollback>
    </changeSet>
    
    <!-- Pattern 3: Environment-gated seed data -->
    <changeSet id="013-seed-test-data" author="trainer" context="dev,test">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM counterparties
            </sqlCheck>
        </preConditions>
    
        <sqlFile path="db/changelog/data/seed-counterparties.sql"/>
    
        <rollback>
            DELETE FROM counterparties;
        </rollback>
    </changeSet>
    
    <!-- Pattern 4: Database vendor gate -->
    <changeSet id="014-postgres-only-tsvector" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
    
        <sql>
            ALTER TABLE instruments ADD COLUMN search_vector TSVECTOR;
            CREATE INDEX idx_instruments_search ON instruments USING GIN (search_vector);
        </sql>
    
        <rollback>
            DROP INDEX IF EXISTS idx_instruments_search;
            ALTER TABLE instruments DROP COLUMN IF EXISTS search_vector;
        </rollback>
    </changeSet>

</databaseChangeLog>
